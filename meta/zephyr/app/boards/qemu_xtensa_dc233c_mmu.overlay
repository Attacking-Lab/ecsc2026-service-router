#include <zephyr/dt-bindings/pcie/pcie.h>

/ {
    chosen {
        zephyr,pcie-controller = &pcie0;
    };

    /* Don't reduce RAM size just because you want to, Zephyr... */
    sram0: memory@0 {
        reg = <0x00000000 0x08000000>;
    };

    intc: interrupt-controller@ff000000 {
        compatible = "cdns,xtensa-core-intc";
        reg = <0xff000000 0x400>;
        interrupt-controller;
        #address-cells = <0>;
        #interrupt-cells = <3>;
    };

    pcie0: pcie@f0100000 {
        compatible = "pci-host-ecam-generic", "pcie-controller";
        device_type = "pci";
        reg = <0xf0100000 0x00600000>;
        bus-range = <0x00 0x05>;
        #address-cells = <3>;
        #size-cells = <2>;
        #interrupt-cells = <1>;
        ranges =
            <0x01000000 0 0xf0000000  0xf0000000 0 0x00010000
             0x02000000 0 0xf4000000  0xf4000000 0 0x04000000
             0x03000000 0 0xf8000000  0xf8000000 0 0x04000000>;
        interrupt-parent = <&intc>;
        interrupt-map-mask = <0x0 0x0 0x0 0x7>;
        interrupt-map =
            <0x800 0x0 0x0 0x1 &intc 0x0 1 0
             0x800 0x0 0x0 0x2 &intc 0x1 1 0
             0x800 0x0 0x0 0x3 &intc 0x2 1 0
             0x800 0x0 0x0 0x4 &intc 0x3 1 0>;

        netdev_pci0: netdev_pci0 {
            compatible = "atmlab,netdev";
            vendor-id = <0xdff4>;
            device-id = <0x1337>;
            interrupts = <0x1 1 0>;
            interrupt-parent = <&intc>;
            status = "okay";
        };

        virtio_blk_pci0: virtio_blk_pci0 {
            compatible = "virtio,pci";
            vendor-id = <0x1af4>;
            device-id = <0x1042>;
            interrupts = <0x2 1 0>;
            interrupt-parent = <&intc>;
            status = "okay";

            disk0: disk0 {
                compatible = "virtio,blk";
                disk-name = "disk0";
                status = "okay";
            };
        };
    };
};
